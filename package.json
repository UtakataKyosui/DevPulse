{
  "name": "devpulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:build": "pnpm --filter @devpulse/admin build",
    "build": "pnpm run admin:build && pnpm --filter @devpulse/web build",
    "check": "biome check --write",
    "dev": "pnpm --filter @devpulse/web dev",
    "deploy": "pnpm run projects:fetch && pnpm run reports:fetch && pnpm run build && pnpm run worker:deploy",
    "deploy:bootstrap": "pnpm run build && pnpm run worker:deploy",
    "deploy:check": "pnpm run build && pnpm run worker:check",
    "format": "biome format --write",
    "preview": "pnpm --filter @devpulse/web preview",
    "config:seed": "node scripts/seed-config.ts",
    "doctor": "node scripts/doctor.ts",
    "setup:secrets": "node scripts/setup-secrets.ts",
    "projects:fetch": "node scripts/projects.ts",
    "reports:fetch": "node scripts/reports.ts fetch",
    "reports:ack": "node scripts/reports.ts ack",
    "reports:generate": "node scripts/reports.ts generate",
    "test": "pnpm run admin:build && vitest run",
    "dev:worker": "pnpm --filter @devpulse/worker dev",
    "worker:deploy": "pnpm --filter @devpulse/worker deploy",
    "worker:check": "pnpm --filter @devpulse/worker deploy:check",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit"
  },
  "dependencies": {
    "@devpulse/domain": "workspace:*",
    "@devpulse/web": "workspace:*",
    "@devpulse/worker": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^21.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.11.2"
}
